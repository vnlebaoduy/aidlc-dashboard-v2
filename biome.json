{
  "files": {
    "ignore": [
      "**/node_modules/**",
      ".kiro/**",
      "aidlc/**",
      "build/**",
      "fixtures/**",
      "node_modules/**",
      "web/dist/**",
      "apps/kirocrew/backend/dist/**",
      "apps/kirocrew/ui/dist/**",
      "web/src/components/ui/**",
      "web/src/routeTree.gen.ts"
    ]
  },
  "organizeImports": {
    "enabled": true
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "style": {
        "noNonNullAssertion": "off"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  }
}
